{
  "artifact": "switchboard observatory contract",
  "config": {
    "defaults": {
      "base_url": "http://localhost:8080/v1",
      "cold_timeout_s": 540.0,
      "effort": {},
      "enabled_call_sites": {},
      "less_token_mode": true,
      "max_tokens": 800,
      "model": "coder-30b",
      "warm_timeout_s": 60.0
    },
    "directory_name": ".switchboard",
    "environment_variable": "SWITCHBOARD_CONFIG",
    "fields": [
      "less_token_mode",
      "enabled_call_sites",
      "effort",
      "base_url",
      "model",
      "cold_timeout_s",
      "warm_timeout_s",
      "max_tokens"
    ],
    "filename": "config.json",
    "source_precedence": [
      {
        "label": "arg",
        "meaning": "explicit --path argument",
        "requires_existing_file": true
      },
      {
        "label": "env",
        "meaning": "SWITCHBOARD_CONFIG environment variable",
        "requires_existing_file": true
      },
      {
        "label": "home",
        "meaning": "existing ~/.switchboard/config.json file",
        "requires_existing_file": true
      },
      {
        "label": "defaults",
        "meaning": "no selected config file; inert site map",
        "requires_existing_file": false
      }
    ],
    "validation": {
      "allowed_effort_tiers": [
        "high",
        "low",
        "max",
        "medium",
        "xhigh"
      ],
      "base_url": "safe http(s) URL only; traversal and shell characters are rejected",
      "max_tokens_minimum": 600,
      "name": "non-empty letters, digits, dot, underscore, and hyphen only",
      "retired_fields": [
        "roles",
        "claims"
      ],
      "unknown_top_level_fields": "rejected; the retired roles and claims keys are unknown keys now that roles live in the registry"
    }
  },
  "inspect": {
    "endpoint_statuses": [
      "offline",
      "online-model-missing",
      "online-model-served"
    ],
    "observed_statuses": [
      "match",
      "mismatch",
      "inherit",
      "unknown"
    ],
    "observed_unknown": "unknown",
    "receipts_states": [
      "absent",
      "ok",
      "invalid"
    ],
    "registry_states": [
      "absent",
      "invalid",
      "ok"
    ],
    "report_fields": [
      "schema_version",
      "state",
      "config_state",
      "source",
      "offload_active",
      "endpoint_status",
      "config",
      "health",
      "sites",
      "registry_state",
      "registry_source",
      "registry_error",
      "receipts_state",
      "receipts_source",
      "receipts_error",
      "roles",
      "error",
      "limitations"
    ],
    "role_fields": [
      "role",
      "description",
      "read_only",
      "claude",
      "codex",
      "claim_id",
      "evidence",
      "observed"
    ],
    "role_host_fields": [
      "model",
      "effort"
    ],
    "role_observed_fields": [
      "model",
      "effort",
      "model_status",
      "effort_status",
      "ts",
      "source_locator"
    ],
    "roles_view_fields": [
      "schema_version",
      "view",
      "registry_state",
      "source",
      "receipts_state",
      "receipts_source",
      "receipts_error",
      "roles",
      "error"
    ],
    "schema_version": 3,
    "site_fields": [
      "site",
      "configured_value",
      "configured_model",
      "default_model",
      "effective_model",
      "site_enabled",
      "offload_allowed",
      "effort_hint"
    ],
    "states": [
      "absent",
      "invalid",
      "inactive",
      "active-offline",
      "active-online-model-missing",
      "active-online"
    ]
  },
  "owner": "switchboard",
  "receipts": {
    "attribution": "role is <role> only when the host recorded the agent type role-<role> and the registry has that row; otherwise unattributed, with requested_model and requested_effort null",
    "content": "metadata only: model, effort and agent-type values from a host transcript; never message content",
    "directory_name": ".switchboard",
    "fields": [
      "ts",
      "host",
      "role",
      "agent_type",
      "requested_model",
      "requested_effort",
      "observed_model",
      "observed_effort",
      "source_locator",
      "registry_sha256"
    ],
    "filename": "receipts.jsonl",
    "hosts": [
      "claude",
      "codex"
    ],
    "latest_rule": "inspect uses the last valid receipt line per role and host and compares it with the current registry row",
    "multi_value_separator": "|",
    "nullable_fields": [
      "agent_type",
      "requested_model",
      "requested_effort",
      "registry_sha256"
    ],
    "unattributed_role": "unattributed",
    "unknown_effort": "UNKNOWN"
  },
  "registry": {
    "claim_statuses": [
      "MEASURED",
      "PARTIAL",
      "ASSERTED",
      "STALE"
    ],
    "default_path": "registry/models.json",
    "environment_variable": "SWITCHBOARD_REGISTRY",
    "fields": [
      "schema_version",
      "roles"
    ],
    "host_fields": [
      "model",
      "effort"
    ],
    "hosts": [
      "claude",
      "codex"
    ],
    "optional_row_fields": [
      "evidence"
    ],
    "roles": [
      "builder",
      "reviewer",
      "reviewer-style",
      "research-verifier",
      "eval-grader",
      "goblin-judge",
      "motion-judge",
      "diagnosis",
      "author",
      "scanner",
      "researcher",
      "extractor",
      "vision-judge",
      "final-judge"
    ],
    "row_fields": [
      "description",
      "read_only",
      "claude",
      "codex",
      "claim_id",
      "evidence"
    ],
    "schema_version": 1,
    "source_precedence": [
      {
        "label": "arg",
        "meaning": "explicit --registry argument"
      },
      {
        "label": "env",
        "meaning": "SWITCHBOARD_REGISTRY environment variable"
      },
      {
        "label": "repo",
        "meaning": "committed switchboard/registry/models.json, when it exists (a repository checkout)"
      },
      {
        "label": "package",
        "meaning": "the copy of registry/models.json packaged in the installed wheel (switchboard/_registry/models.json), used only when the repo copy does not exist"
      }
    ],
    "states": [
      "absent",
      "invalid",
      "ok"
    ],
    "validation": {
      "claim_id": "required; non-empty letters, digits, dot, underscore, and hyphen only",
      "claude_effort_levels": [
        "high",
        "low",
        "max",
        "medium",
        "xhigh"
      ],
      "codex_effort_levels": [
        "high",
        "low",
        "max",
        "medium",
        "ultra",
        "xhigh"
      ],
      "effort": "inherit, or one of that host's own levels; a level only the other host has is invalid",
      "inherit": "inherit",
      "inherit_meaning": "no key is written for that host; it resolves exactly as it does today",
      "missing_file": "absent state, exit 0",
      "model": "inherit, or an exact model ID containing a digit; letters, digits, dot, underscore, and hyphen only; a value containing any rejected_model_substrings entry (case-insensitive) is invalid",
      "rejected_model_aliases": [
        "haiku",
        "sonnet",
        "opus",
        "fable"
      ],
      "rejected_model_substrings": [
        "fable"
      ],
      "role_name_pattern": "^[a-z][a-z0-9-]*$",
      "roles": "exactly the listed roles; unknown and missing roles are invalid",
      "unknown_fields": "rejected at every level; duplicate JSON keys are rejected",
      "unreadable_or_failing_file": "invalid state, exit 0"
    }
  },
  "schema_version": 2
}
